<!DOCTYPE html>
<html lang="{{ locales[locale].code }}" dir="{{ locales[locale].direction }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ variant.copy.metaTitle }}</title>
    <meta name="description" content="{{ variant.copy.metaDescription }}">
    <meta name="robots" content="noindex, follow">
    <link rel="icon" type="image/png" sizes="64x64" href="/assets/images/brand/favicon-64.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/brand/apple-touch-icon.png">
    <meta name="theme-color" content="#ffffff">
    <link rel="stylesheet" href="/assets/css/global.css">
    <link rel="stylesheet" href="/assets/css/pages.css">
    <link rel="stylesheet" href="/assets/css/not-found.css">
  </head>
  <body class="locale-{{ locale | lower }} not-found-body">
    {% include "components/header.njk" %}
    {{ content | safe }}
    {% include "components/footer.njk" %}
    <script>
      window.SITE_CONFIG = {{ runtimeConfig(locale) | safe }};
    </script>
    <script src="/assets/js/main.js"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7HP7TDGVF7"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-7HP7TDGVF7');
    </script>
  </body>
</html>
